{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "plugin/build",
    "rootDir": "plugin/src"
  },
  "include": ["plugin/src/**/*.ts"]
}
